# Copy to .env.local. Never commit real credentials.

# Local Neo4j — docker compose up -d (or brew install neo4j), then npm run seed.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=paytrace-local
NEO4J_DATABASE=neo4j

# Neo4j Aura — swap these in instead of the block above.
# NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=replace-with-your-aura-password
