# Copy to .env.local. Never commit real credentials.

# Local Neo4j — docker compose up -d (or brew install neo4j), then npm run seed.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=paytrace-local
NEO4J_DATABASE=neo4j

# Neo4j Aura — swap these in instead of the block above.
# NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=replace-with-your-aura-password

# Pairing code shared with the Paytrace Companion Android app (Live mode)
PAYTRACE_DEVICE_CODE=

# Explicit opt-in for a single consenting test profile; private environment only.
PAYTRACE_LIVE_ENABLED=false
PAYTRACE_LIVE_PROFILE=
PAYTRACE_READ_CODE=

# Desktop OAuth credentials + sender domains/suffixes (comma-separated, shared with web sync).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_ALLOWED_DOMAINS=.com,.in
# GMAIL_QUERY=newer_than:7d {payment receipt transaction subscription debit}

# Web OAuth client (separate from desktop OAuth above). For local development:
PAYTRACE_APP_URL=http://localhost:3000
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
# Generate a unique 32-byte key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYTRACE_AUTH_KEY=
# Optional additional Gmail search filter for signed-in accounts.
# GMAIL_ACCOUNT_QUERY={payment receipt transaction mandate subscription debit}
# Optional bounded semantic discovery via local Ollama only; outputs stay provisional.
PAYTRACE_EMAIL_AI_ENABLED=false
