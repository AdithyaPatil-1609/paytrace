# Copy to .env.local. Never commit real credentials.

# Main, Aura Agent, and optional demo databases. Never share the hosted agent instance with either of the others.

# 1. Main database: signed-in users, real Gmail and SMS records, personal warnings.
#    Neo4j Aura in production; local Docker (docker compose up -d) for development.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=paytrace-local
NEO4J_DATABASE=neo4j
# NEO4J_URI=neo4j+s://your-personal-instance.databases.neo4j.io
# NEO4J_PASSWORD=replace-with-your-aura-password

# 2. Aura Agent database: shared, non-personal merchant knowledge catalog.
#    Historical PERSONAL_NEO4J_* names retained for existing installations.
#    Seed via npm run agent:seed. Never copy private profiles into this database.
PERSONAL_NEO4J_URI=
PERSONAL_NEO4J_USERNAME=
PERSONAL_NEO4J_PASSWORD=
PERSONAL_NEO4J_DATABASE=neo4j

# Aura Agent API (keep false for Internal mode; enable only after validating External mode)
# Server-only Aura API credentials; not the database username/password. See db/neo4j/AGENT.md.
PAYTRACE_AURA_AGENT_ENABLED=false
AURA_AGENT_ENDPOINT=
AURA_CLIENT_ID=
AURA_CLIENT_SECRET=

# Optional demo database: synthetic data only (npm run seed writes here, never to the main or agent database).
#    Use a separate Aura instance in production. Locally the Docker database may serve main and demo.
NEO4J_DEMO_URI=bolt://localhost:7687
NEO4J_DEMO_USERNAME=neo4j
NEO4J_DEMO_PASSWORD=paytrace-local
NEO4J_DEMO_DATABASE=neo4j
# NEO4J_DEMO_URI=neo4j+s://your-demo-instance.databases.neo4j.io
# NEO4J_DEMO_PASSWORD=replace-with-your-demo-aura-password

# OLD shared pairing code for the Android app. Phones with the signing update pair
# from the account page instead (docs/security/DEVICE_SIGNING.md). Set
# PAYTRACE_ALLOW_DEVICE_CODE=false once every phone signs its requests.
PAYTRACE_DEVICE_CODE=
PAYTRACE_ALLOW_DEVICE_CODE=true

# Explicit opt-in for a single consenting test profile; private environment only.
PAYTRACE_LIVE_ENABLED=false
PAYTRACE_LIVE_PROFILE=
PAYTRACE_READ_CODE=

# Desktop OAuth credentials + sender domains/suffixes (comma-separated, shared with web sync).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_ALLOWED_DOMAINS=.com,.in
# GMAIL_QUERY=newer_than:7d {payment receipt transaction subscription debit}

# Web OAuth client (separate from desktop OAuth above). For local development:
PAYTRACE_APP_URL=http://localhost:3000
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
# Generate a unique 32-byte key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYTRACE_AUTH_KEY=
# Key version stored with every encrypted token. To rotate: new key in PAYTRACE_AUTH_KEY
# with a new id, old key and id in the two PREVIOUS settings (docs/security/REMEDIATION.md F12).
PAYTRACE_AUTH_KEY_ID=1
# PAYTRACE_AUTH_KEY_PREVIOUS=
# PAYTRACE_AUTH_KEY_PREVIOUS_ID=
# Optional additional Gmail search filter for signed-in accounts.
# GMAIL_ACCOUNT_QUERY={payment receipt transaction mandate subscription debit}
# Optional bounded semantic discovery via local Ollama only; outputs stay provisional.
PAYTRACE_EMAIL_AI_ENABLED=false
