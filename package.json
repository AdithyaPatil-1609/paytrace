{
  "name": "paytrace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:public": "next start -H 127.0.0.1 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/security/*.test.ts",
    "seed": "node --import tsx scripts/seed-neo4j.ts",
    "test:cypher": "node --import tsx --test --test-concurrency=1 tests/cypher/*.test.ts",
    "test:all": "node --import tsx --test tests/*.test.ts tests/cypher/*.test.ts",
    "demo": "node --import tsx scripts/demo-live.ts",
    "gmail:authorize": "node --import tsx scripts/gmail.ts --authorize",
    "gmail:sync": "node --import tsx scripts/gmail.ts",
    "gmail:accounts": "node --import tsx scripts/gmail-accounts.ts",
    "agent:seed": "node --import tsx scripts/seed-agent-knowledge.ts",
    "ai:alerts": "ml/.venv/bin/python -m mlx_lm server --model mlx-community/Qwen3-8B-4bit --adapter-path ml/adapters/qwen3-8b-alerts --host 127.0.0.1 --port 8080",
    "ai:eval": "node --import tsx scripts/eval-assistant.ts",
    "ai:read": "node --import tsx scripts/read-message.ts"
  },
  "dependencies": {
    "google-auth-library": "^11.3.4",
    "neo4j-driver": "6.0.1",
    "next": "^16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "^16.4.6",
    "playwright": "1.64.1",
    "tsx": "4.20.6",
    "typescript": "6.0.3"
  }
}
