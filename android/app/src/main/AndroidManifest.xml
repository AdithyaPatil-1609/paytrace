
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.RECEIVE_SMS" />

    <uses-permission
        android:name="android.permission.INTERNET" />

    <!-- Card M3, optional: app usage for known subscription apps only. The person
         switches it on in Settings > Usage access; the app cannot grant it itself. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Card M3: lets the app see whether these known subscription apps are installed.
         Same list as KnownApps.kt. -->
    <queries>
        <package android:name="com.netflix.mediaclient" />
        <package android:name="com.spotify.music" />
        <package android:name="in.startv.hotstar" />
        <package android:name="com.amazon.avod.thirdpartyclient" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.jio.media.ondemand" />
        <package android:name="com.sonyliv" />
        <package android:name="com.graymatrix.did" />
        <package android:name="com.google.android.apps.subscriptions.red" />
        <package android:name="com.linkedin.android" />
        <package android:name="com.duolingo" />
        <package android:name="com.apple.android.music" />
        <package android:name="com.audible.application" />
        <package android:name="in.swiggy.android" />
        <package android:name="com.application.zomato" />
        <package android:name="com.openai.chatgpt" />
        <package android:name="com.canva.editor" />
        <package android:name="com.dropbox.android" />
        <package android:name="com.microsoft.office.officehubrow" />
        <package android:name="com.bsbportal.music" />
        <package android:name="com.jio.media.jiobeats" />
        <package android:name="com.gaana" />
        <package android:name="com.tinder" />
        <package android:name="com.medium.reader" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="Paytrace Companion"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.PaytraceCompanion">

        <!-- Lets Google Play services fetch the QR scanner when the app is installed. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open in Paytrace app": paytrace://connect?server=...&token=...
                 The app always asks the user to confirm before connecting. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="paytrace" android:host="connect" />
                <data android:scheme="paytrace" android:host="pair" />
            </intent-filter>

        </activity>

        <receiver
            android:name=".SmsReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">

            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>

        </receiver>

    </application>

</manifest>
